rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── 🛡️ FUNCIONES DE SEGURIDAD Y ROLES COMPARTIDOS ──────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Acceso total de emergencia. Se mantiene desactivado a proposito:
    // antes se otorgaba admin a cualquier correo que contuviera "robert",
    // "ruidiaz" o "diego.campos", lo que permitia escalar privilegios
    // registrandose con un correo que incluyera esos textos.
    // Para habilitar un super admin, anade su UID exacto a esta lista.
    function isSuperAdminAuth() {
      return false;
    }

    // Busca al usuario en ambas colecciones unificadas
    function getUserData() {
      let uid = request.auth.uid;
      let au = /databases/$(database)/documents/airtek_users/$(uid);
      let eu = /databases/$(database)/documents/energy_users/$(uid);
      return exists(au) ? get(au).data : (exists(eu) ? get(eu).data : {});
    }

    // Administrador estricto: Root, Nodos, PM o Almacén
    function isStrictAdmin() {
      let data = getUserData();
      let isRoot = data.get('role', data.get('rol', '')) == 'admin';
      let isNodos = data.get('apps', {}).get('nodos', '') == 'admin';
      let isPm = data.get('apps', {}).get('pm', '') == 'admin';
      let isAlmacen = data.get('apps', {}).get('almacen', '') == 'admin';
      
      return isAuthenticated() && (isSuperAdminAuth() || isRoot || isNodos || isPm || isAlmacen);
    }

    function isApprovedUser() {
      let data = getUserData();
      return isAuthenticated() && (isSuperAdminAuth() || data.get('approved', false) == true);
    }

    // Permisos específicos para la app de Gestión de Nodos y Energía
    function isSupervisorOrAdminNodos() {
      let data = getUserData();
      let role = data.get('apps', {}).get('nodos', data.get('role', data.get('rol', '')));
      return isApprovedUser() && (isSuperAdminAuth() || role == 'supervisor' || role == 'admin');
    }

    function canWriteNodos() {
      let data = getUserData();
      let role = data.get('apps', {}).get('nodos', data.get('role', data.get('rol', '')));
      return isApprovedUser() && (role == 'tecnico' || role == 'supervisor' || role == 'admin');
    }

    // Permisos específicos para PM V7 (Project Management)
    function canWritePM() {
      let data = getUserData();
      let pmRole = data.get('apps', {}).get('pm', data.get('role', data.get('rol', '')));
      return isApprovedUser() && (pmRole == 'admin' || pmRole == 'editor' || pmRole == 'supervisor');
    }

    // Permisos específicos para Almacén
    function canWriteAlmacen() {
      let data = getUserData();
      let almRole = data.get('apps', {}).get('almacen', data.get('role', data.get('rol', '')));
      return isApprovedUser() && (almRole == 'admin' || almRole == 'operador');
    }

    // ── 1. NODOS Y SUBCOLECCIONES (Nodos, Equipos, Combustible, Registros) ─
    // Compatible con cualquier profundidad de subcolección ({document=**})
    match /energy_nodes/{document=**} {
      allow read: if isApprovedUser();
      allow create, update: if isStrictAdmin() || canWriteNodos();
      // Protección de integridad: borrar nodos o historiales requiere supervisor o admin
      allow delete: if isStrictAdmin() || isSupervisorOrAdminNodos();
    }

    // Registros directos en raíz (compatibilidad legacy)
    match /energy_records/{document=**} {
      allow read: if isApprovedUser();
      allow create, update: if isStrictAdmin() || canWriteNodos();
      allow delete: if isStrictAdmin() || isSupervisorOrAdminNodos();
    }

    // ── 2. CONFIGURACIÓN GENERAL (Personal Autorizado) ─────────────────────
    match /energy_config/{document=**} {
      allow read: if isApprovedUser();
      allow write: if isStrictAdmin() || isSupervisorOrAdminNodos();
    }

    // ── 3. PM V7 Y ALMACÉN (100% Preservado para las otras aplicaciones) ───
    match /artifacts/{appId}/public/data/{collection=**} {
      allow read: if isAuthenticated();
      // Mantiene exactamente la lógica original requerida por PM y Almacén
      allow write, delete: if isStrictAdmin() || canWritePM() || canWriteAlmacen();
    }

    // ── 4. PERFILES COMPARTIDOS (airtek_users) ─────────────────────────────
    match /airtek_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isStrictAdmin());
      
      allow create: if (
        isAuthenticated() && request.auth.uid == uid 
        && (
          isSuperAdminAuth()
          || (
            request.resource.data.get('approved', true) == false
            && request.resource.data.get('role', '') != 'admin'
            && request.resource.data.get('role', '') != 'supervisor'
            && request.resource.data.get('apps', {}).get('nodos', '') != 'admin'
            && request.resource.data.get('apps', {}).get('nodos', '') != 'supervisor'
            && request.resource.data.get('apps', {}).get('pm', '') != 'admin'
            && request.resource.data.get('apps', {}).get('pm', '') != 'supervisor'
            && request.resource.data.get('apps', {}).get('almacen', '') != 'admin'
            && request.resource.data.get('apps', {}).get('almacen', '') != 'supervisor'
          )
        )
      ) || isStrictAdmin();
                    
      allow update: if isStrictAdmin()
                    || (
                      isAuthenticated() && request.auth.uid == uid
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rol', 'apps', 'approved', 'email'])
                    );
                    
      allow delete: if isStrictAdmin();
    }

    // ── 5. PERFILES LEGACY (energy_users) ──────────────────────────────────
    match /energy_users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isStrictAdmin());
      
      allow create: if (
        isAuthenticated() && request.auth.uid == uid 
        && (
          isSuperAdminAuth()
          || (
            request.resource.data.get('approved', true) == false
            && request.resource.data.get('role', '') != 'admin'
            && request.resource.data.get('role', '') != 'supervisor'
            && request.resource.data.get('rol', '') != 'admin'
            && request.resource.data.get('rol', '') != 'supervisor'
          )
        )
      ) || isStrictAdmin();
                    
      allow update: if isStrictAdmin()
                    || (
                      isAuthenticated() && request.auth.uid == uid
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rol', 'approved', 'email'])
                    );
                    
      allow delete: if isStrictAdmin();
    }
  }
}
